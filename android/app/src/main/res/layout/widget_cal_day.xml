<?xml version="1.0" encoding="utf-8"?>
<!-- A Calendar widget grid cell: number, word-count dots, the corner mark
     for open tasks, and the today / selected ring (CalendarPanel's cell). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@+id/zn_cal_cell"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="@dimen/zn_cal_cell_height"
    android:padding="1dp">

    <ImageView
        android:id="@+id/zn_cal_cell_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/zn_cal_cell"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/zn_cal_cell_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/zn_cal_ring"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/zn_cal_cell_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/znWidgetFg"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/zn_cal_cell_dots"
            android:layout_width="wrap_content"
            android:layout_height="7dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/znWidgetMuted"
            android:textSize="8sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/zn_cal_cell_mark"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        android:src="@drawable/zn_circle"
        android:tint="@color/znWidgetAccent"
        android:visibility="gone"
        android:importantForAccessibility="no" />
</FrameLayout>
