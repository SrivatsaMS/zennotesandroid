<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for the Calendar widget (API 31+ previewLayout). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint,HardcodedText"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/zn_widget_bg"
        android:tint="@color/znWidgetBg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/widget_preview_month"
            android:textColor="@color/znWidgetFg"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="MON"
                android:textColor="@color/znWidgetMuted"
                android:textSize="10sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TUE"
                android:textColor="@color/znWidgetMuted"
                android:textSize="10sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="WED"
                android:textColor="@color/znWidgetMuted"
                android:textSize="10sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="THU"
                android:textColor="@color/znWidgetMuted"
                android:textSize="10sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="FRI"
                android:textColor="@color/znWidgetMuted"
                android:textSize="10sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SAT"
                android:textColor="@color/znWidgetMuted"
                android:textSize="10sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SUN"
                android:textColor="@color/znWidgetMuted"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="19"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="20"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="21"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="22"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="23"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="24"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="25"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="26"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="27"
                android:textColor="@color/znWidgetAccent"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="28"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="29"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="30"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="31"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/znWidgetMuted"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/znWidgetMuted"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/znWidgetMuted"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/znWidgetMuted"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/znWidgetMuted"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/znWidgetMuted"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="7"
                android:textColor="@color/znWidgetMuted"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="8"
                android:textColor="@color/znWidgetMuted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="@string/widget_preview_week"
            android:textColor="@color/znWidgetFg"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_zn_square"
                android:tint="@color/znWidgetMuted"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_preview_cal_task_1"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_zn_square"
                android:tint="@color/znWidgetMuted"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_preview_cal_task_2"
                android:textColor="@color/znWidgetFg"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_cal_task_2_note"
                android:textColor="@color/znWidgetMuted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
