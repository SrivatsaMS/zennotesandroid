<?xml version="1.0" encoding="utf-8"?>
<!-- A day heading in the Calendar widget's week list ("27 TUE", Today, count). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@+id/zn_agenda_day"
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/zn_agenda_day_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:textColor="@color/znWidgetMuted"
        android:textSize="11sp" />

    <FrameLayout
        android:id="@+id/zn_agenda_today"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginStart="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/zn_agenda_today_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/zn_cal_cell"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/zn_agenda_today_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="@string/widget_today"
            android:textColor="@color/znWidgetAccent"
            android:textSize="10sp" />
    </FrameLayout>

    <!-- A spacer: RemoteViews inflates no plain View. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/zn_agenda_day_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/znWidgetMuted"
        android:textSize="11sp" />
</LinearLayout>
